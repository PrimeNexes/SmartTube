<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing worth restoring on another phone: TV PINs are re-entered once -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
